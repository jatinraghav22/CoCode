# Backend Environment Variables
NODE_ENV=production
PORT=5000

# Authentication Secret
JWT_SECRET=cocodee_jwt_secret_super_secure_key_change_in_production

# Frontend Origin for CORS (e.g. your Vercel deployment URL)
FRONTEND_URL=http://localhost:5173
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: External Database URL (default uses local JSON user store)
DATABASE_URL=

# Optional: Custom Judge0 Execution Service
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=
