# ==========================================
# CoCode - Environment Variables Reference
# ==========================================

# -----------------
# Backend Configuration (Node / Express / Socket.IO)
# -----------------
NODE_ENV=production
PORT=10000
JWT_SECRET=cocodee_jwt_secret_super_secure_key_change_in_production

# Frontend Origin(s) for CORS & WebSocket access
# Set this to your deployed Vercel domain (e.g. https://your-cocode.vercel.app)
FRONTEND_URL=https://your-frontend.vercel.app
CLIENT_URL=https://your-frontend.vercel.app
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# Optional: External Database Connection URL (if migrating from local JSON file storage)
DATABASE_URL=

# Optional: Judge0 Custom Execution Server
JUDGE0_URL=https://ce.judge0.com
JUDGE0_API_KEY=
JUDGE0_API_HOST=

# -----------------
# Frontend Configuration (Vite / React)
# -----------------
# Set this to your deployed Render backend domain
VITE_API_URL=https://your-backend.onrender.com
VITE_SOCKET_URL=https://your-backend.onrender.com
VITE_BACKEND_URL=https://your-backend.onrender.com

# Optional: Direct Execution APIs
VITE_JUDGE0_URL=https://ce.judge0.com
VITE_JUDGE0_API_KEY=
VITE_JUDGE0_API_HOST=
VITE_PISTON_URL=https://emkc.org/api/v2/piston
