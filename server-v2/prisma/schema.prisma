generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Phase 6: Real-Time Collaboration relations
  ownedRooms   CollaborationRoom[]  @relation("RoomOwner")
  roomMemberships RoomParticipant[] @relation("ParticipantUser")

  // Phase 7: Projects & Coding Activity relations
  projects     Project[]        @relation("UserProjects")
  activities   CodingActivity[] @relation("UserActivities")

  @@map("users")
}

// Phase 6: Collaboration room — persistent room record.
// A room is never deleted automatically; only the owner can close it.
model CollaborationRoom {
  id        String   @id @default(cuid())
  code      String   @unique // 6-char uppercase alphanumeric invite code
  name      String
  isPrivate Boolean  @default(true)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The user who created this room
  ownerId   String
  owner     User   @relation("RoomOwner", fields: [ownerId], references: [id])

  // All participants who have ever joined (or are currently in) this room
  participants RoomParticipant[] @relation("RoomParticipants")

  // Phase 6 Production: Persistent room code documents
  documents    RoomDocument[]    @relation("RoomDocuments")

  @@index([code])
  @@index([ownerId])
  @@map("collaboration_rooms")
}

// Phase 6: Room participant record — tracks membership per room.
// A participant record is created when a user first joins a room.
// isActive reflects whether the user is currently connected.
model RoomParticipant {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  joinedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      CollaborationRoom @relation("RoomParticipants", fields: [roomId], references: [id])
  user      User              @relation("ParticipantUser",  fields: [userId],  references: [id])

  // A user can only have one participant record per room
  @@unique([roomId, userId])
  @@index([roomId])
  @@index([userId])
  @@map("room_participants")
}

// Phase 6: Persistent collaboration documents — keeps file content in TiDB Cloud
// so that documents survive backend restarts and multi-instance restarts.
model RoomDocument {
  id        String   @id @default(cuid())
  roomId    String
  fileId    String   // Canonical file identifier e.g. "f-1"
  filename  String   // File display name or relative path e.g. "index.js"
  language  String   @default("javascript")
  content   String   @db.LongText
  yjsState  Bytes?   @db.LongBlob
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  room      CollaborationRoom @relation("RoomDocuments", fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, fileId])
  @@index([roomId])
  @@map("room_documents")
}

// Phase 7: Persistent Project Management
model Project {
  id              String   @id @default(cuid())
  userId          String
  name            String
  description     String?  @db.Text
  defaultLanguage String   @default("javascript")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User           @relation("UserProjects", fields: [userId], references: [id], onDelete: Cascade)
  files           ProjectFile[]  @relation("ProjectFiles")
  activities      CodingActivity[] @relation("ProjectActivities")

  @@index([userId])
  @@map("projects")
}

// Phase 7: Project File Management
model ProjectFile {
  id        String   @id @default(cuid())
  projectId String
  name      String
  path      String
  language  String   @default("javascript")
  content   String   @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   Project  @relation("ProjectFiles", fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
}

// Phase 7: Coding Activity Tracking
model CodingActivity {
  id              String   @id @default(cuid())
  userId          String
  projectId       String?
  language        String
  eventType       String
  status          String
  durationSeconds Int?
  createdAt       DateTime @default(now())

  user            User     @relation("UserActivities", fields: [userId], references: [id], onDelete: Cascade)
  project         Project? @relation("ProjectActivities", fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([userId, createdAt])
  @@index([userId, eventType])
  @@map("coding_activities")
}
