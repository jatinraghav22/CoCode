# Server Port
PORT=5000

# Client URL (for CORS and Socket.io)
CLIENT_URL=http://localhost:5173

# MySQL Database Connection String
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Example: mysql://root:YOUR_PASSWORD@localhost:3306/cocode
DATABASE_URL="mysql://root:password@localhost:3306/cocode"

# JWT Authentication
JWT_SECRET=cocode_jwt_secret_key_change_in_production_123456789
JWT_EXPIRES_IN=7d

# Remote Code Execution Engine (Judge0 CE)
JUDGE0_URL=https://ce.judge0.com
