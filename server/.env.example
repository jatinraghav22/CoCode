# ==============================================================================
# CoCode Server Environment Configuration (.env.example)
# ==============================================================================

# Server Port
PORT=5000

# MySQL Database Connection (Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:password@localhost:3306/cocode"

# Code Execution Engine (Judge0 CE)
JUDGE0_BASE_URL="https://ce.judge0.com"
# Optional Judge0 Auth Token (if using an authenticated/self-hosted Judge0 instance)
# JUDGE0_AUTH_TOKEN=""

# AI Coding Assistant Provider (Optional)
# Configure one of the following to activate live cloud AI models:
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="AIza..."
