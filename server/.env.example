# ==============================================================================
# CoCode Server Environment Configuration (.env.example)
# Copy this to .env and fill in your real values.
# NEVER commit your .env file to git.
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development

# MySQL Database Connection (Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/cocode_db"

# JWT Authentication
# JWT_SECRET must be a long, random string in production (minimum 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="7d"
JWT_ISSUER="cocode-api"
JWT_AUDIENCE="cocode-client"

# CORS — comma-separated list of allowed frontend origins
# Example: "http://localhost:5173,https://your-app.vercel.app"
CLIENT_URL="http://localhost:5173"

# Code Execution Engine (Judge0 CE)
JUDGE0_BASE_URL="https://ce.judge0.com"
# Optional Judge0 Auth Token (if using an authenticated/self-hosted Judge0 instance)
# JUDGE0_AUTH_TOKEN=""

# AI Coding Assistant Provider (Optional)
# Configure one of the following to activate live cloud AI models:
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="AIza..."
